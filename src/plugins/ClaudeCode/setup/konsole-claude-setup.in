"""Add or remove the Claude Code hooks that drive Konsole's Claude Code plugin.

    konsole-claude-setup install     add the hooks to Claude Code's settings
    konsole-claude-setup uninstall   remove them
    konsole-claude-setup status      say whether they are installed

The settings are $CLAUDE_CONFIG_DIR/settings.json, by default
~/.claude/settings.json. A copy of the file is kept next to it before any
change. Only hooks that run claude-code-hook are ever added or removed.
"""

import json
import os
import shutil
import sys
import tempfile
import time

HOOK = "@CLAUDECODE_TOOLS_DIRECTORY@/claude-code-hook"

# The events iTerm2's integration hooks, which cc-status handles.
EVENTS = [
    "UserPromptSubmit",
    "Stop",
    "StopFailure",
    "Notification",
    "PermissionRequest",
    "SessionEnd",
    "PreToolUse",
    "PostToolUse",
    "SessionStart",
    "SubagentStop",
]


def settings_path():
    directory = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
    return os.path.join(directory, "settings.json")


def load(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return {}


def is_ours(hook):
    return isinstance(hook, dict) and "claude-code-hook" in str(hook.get("command", ""))


def without_ours(groups):
    """The event's matcher groups with our hooks taken out, dropping groups left empty."""
    kept = []
    for group in groups:
        hooks = [h for h in group.get("hooks", []) if not is_ours(h)]
        if hooks:
            kept.append({**group, "hooks": hooks})
        elif not any(is_ours(h) for h in group.get("hooks", [])):
            kept.append(group)
    return kept


def installed_events(settings):
    hooks = settings.get("hooks", {})
    return [e for e in EVENTS if any(is_ours(h) for g in hooks.get(e, []) for h in g.get("hooks", []))]


def save(path, settings):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if os.path.exists(path):
        shutil.copy2(path, f"{path}.konsole-claude-{time.strftime('%Y%m%d-%H%M%S')}.bak")
    # Write and rename, so Claude Code never reads a half-written file.
    fd, temporary = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".settings.", suffix=".json")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(settings, f, indent=2)
        f.write("\n")
    if os.path.exists(path):
        shutil.copymode(path, temporary)
    os.replace(temporary, path)


def install(path):
    settings = load(path)
    before = json.dumps(settings, sort_keys=True)
    hooks = settings.setdefault("hooks", {})
    for event in EVENTS:
        # Replace rather than add, so a moved hook is repaired, not doubled.
        groups = without_ours(hooks.get(event, []))
        groups.append({"hooks": [{"type": "command", "command": HOOK}]})
        hooks[event] = groups
    if json.dumps(settings, sort_keys=True) == before:
        print(f"Already installed in {path}")
        return 0
    save(path, settings)
    print(f"Installed the Claude Code hooks for Konsole in {path}")
    return 0


def uninstall(path):
    settings = load(path)
    if not installed_events(settings):
        print(f"Not installed in {path}")
        return 0
    hooks = settings.get("hooks", {})
    for event in list(hooks):
        groups = without_ours(hooks[event])
        if groups:
            hooks[event] = groups
        else:
            del hooks[event]
    if not hooks:
        settings.pop("hooks", None)
    save(path, settings)
    print(f"Removed the Claude Code hooks for Konsole from {path}")
    return 0


def status(path):
    events = installed_events(load(path))
    if len(events) == len(EVENTS):
        print(f"Installed in {path}")
        return 0
    if events:
        missing = ", ".join(e for e in EVENTS if e not in events)
        print(f"Partly installed in {path}; missing: {missing}. Run: konsole-claude-setup install")
        return 2
    print(f"Not installed in {path}. Run: konsole-claude-setup install")
    return 1


def main():
    commands = {"install": install, "uninstall": uninstall, "status": status}
    if len(sys.argv) != 2 or sys.argv[1] not in commands:
        print(__doc__.strip(), file=sys.stderr)
        return 64
    try:
        return commands[sys.argv[1]](settings_path())
    except json.JSONDecodeError as error:
        print(f"{settings_path()} is not valid JSON ({error}); not changing it.", file=sys.stderr)
        return 65


if __name__ == "__main__":
    sys.exit(main())
